# Copy to .env.test and fill in. Never commit the filled file (.gitignore'd).
#
#   cp .env.test.example .env.test && nano .env.test
#   docker compose -f docker-compose.test.yml --env-file .env.test up -d --build
#   ./scripts/smoke-test-env.sh
#
# This is the env contract for the TEST environment (docker-compose.test.yml).
# Sibling files: .env.example = local dev, .env.deploy.example = production.
# Every var below says where its value comes from PER ENVIRONMENT, because that
# — not the code — is what actually differs between the three.
#
# WHERE A TEST VALUE COMES FROM, by source:
#   [generate]  you mint it once with openssl/uuidgen and it lives only in
#               .env.test on the test host — POSTGRES_PASSWORD, BRAINIAC_TOKENS,
#               CONSOLE_PASSCODE, CONSOLE_SESSION_SECRET
#   [dashboard] copy it out of a vendor console — QWEN_API_KEY (Alibaba Model
#               Studio), SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN (Sentry project
#               settings), LIGHTTRACK_URL / LIGHTTRACK_KEY (your LightTrack
#               instance)
#   [ci secret] if a CI job brings this stack up, the same names go in the
#               repository/environment secret store and CI writes .env.test —
#               every [generate] and [dashboard] value above qualifies
#   [fixed]     not a secret; the value is a property of this stack —
#               BRAINIAC_CONSOLE_URL, LIGHTTRACK_PROJECT, RUST_LOG
#
# scripts/smoke-test-env.sh sources THIS file (as .env.test) to read
# BRAINIAC_API_TOKEN, so keeping the two in sync is what makes the smoke check
# a one-liner.

# ── Postgres ────────────────────────────────────────────────────────────
# Container-local; published on 127.0.0.1:5434 so you can psql the test corpus.
#   local      → literal "brainiac" (docker-compose.yml hardcodes it)
#   test       → generate one, keep it in this file only:  openssl rand -base64 24
#   production → a DIFFERENT generated secret; never share it with test
POSTGRES_PASSWORD=change-me

# ── Identity: break-glass admin map ─────────────────────────────────────
# JSON: bearer secret → principal. Env-map entries carry every scope and are
# un-revocable, so this is bootstrap-only in any environment.
#   local      → whatever you like; the corpus is disposable
#   test       → its OWN secret and its OWN org/user UUIDs. Do NOT reuse the
#                production org id: a test run that writes memories must never
#                be able to land in the production org's namespace.
#   production → generated once, then kept offline (see .env.deploy.example)
#   openssl rand -hex 32   # secret        uuidgen   # org id, then user id
BRAINIAC_TOKENS={"change-me-test-admin":{"org":"00000000-0000-0000-0000-000000000001","user":"00000000-0000-0000-0000-000000000002","teams":[]}}

# Token the console uses to reach the server. Must be a key in the map above or
# a minted `brk_` key (POST /v1/tokens).
#   local/test → the break-glass secret is acceptable
#   production → mint a scoped `brk_` key and use that
BRAINIAC_API_TOKEN=change-me-test-admin

# ── Console access gate ─────────────────────────────────────────────────
# Without a passcode the console serves only "/" and "/demo" — keep it set in
# test so you exercise the same fail-closed path production runs.
#   local      → optional
#   test       → set it (a shared team passcode is fine):  openssl rand -base64 32
#   production → REQUIRED, long and rotated
CONSOLE_PASSCODE=change-me-test-console
# Signs the session cookie independently of the passcode. REQUIRED by
# docker-compose.test.yml (as in production): without it the cookie is keyed on
# the passcode itself and a guessed passcode forges a session offline.
#   openssl rand -base64 32
CONSOLE_SESSION_SECRET=change-me-test-session-secret

# Public URL of the test console. Onboarding device-flow approval links are
# built from it; leave the default when you browse the test host from itself.
#   local      → http://localhost:3100
#   test       → http://localhost:3200 (or http://<test-host>:3200)
#   production → the real public URL
BRAINIAC_CONSOLE_URL=http://localhost:3200

# ── LLM provider ────────────────────────────────────────────────────────
# Full matrix + per-stage routing: docs/deploy/providers.md. The compose file
# passes every provider var through; set only the ones your choice needs.
#   test → either mirror production's provider (to catch provider-specific
#          breakage) or drop to a cheaper model / BRAINIAC_EMBEDDER=deterministic
#          (no API at all, ~0.19 NDCG lower — fine for smoke and plumbing work).
BRAINIAC_PROVIDER=qwen
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
BRAINIAC_EMBEDDER=qwen
# Use a SEPARATE API key from production where the provider allows it, so test
# traffic shows up as its own line on the bill and can be revoked alone.
# BRAINIAC_MODEL=
# OPENAI_API_KEY=      # + OPENAI_MODEL / OPENAI_BASE_URL for OpenAI-compatible
# ANTHROPIC_API_KEY=   # + ANTHROPIC_MODEL
# GEMINI_API_KEY=      # + GOOGLE_MODEL

# ── Environment posture (this is what makes it "test") ──────────────────
# BRAINIAC_ENV is pinned to "test" INSIDE docker-compose.test.yml — it is not an
# override here, it is the identity of this stack.

# Sentry — ON in test when a DSN is set; every event is tagged environment=test.
#   local      → unset (Sentry never initializes when BRAINIAC_ENV=local)
#   test       → set it; use a Sentry environment filter to keep test noise out
#                of the production issue stream
#   production → set it
SENTRY_DSN=
# Console (browser) DSN. See docs/deploy/test-env.md § Known gaps — this
# currently reaches the Node runtime only, not the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=

# LightTrack (LLM-call telemetry) — UNSET ⇒ disabled, a hard no-op.
#   local      → http://127.0.0.1:8787  (docker compose up -d lighttrack)
#   test       → https://<your-test-lighttrack-instance>  ← the designed home
#   production → SKIPPED by policy; leave unset
LIGHTTRACK_URL=
# LIGHTTRACK_KEY=
LIGHTTRACK_PROJECT=brainiac-test

# Log level. Test is the environment you actually read logs in.
RUST_LOG=info,brainiac=debug
