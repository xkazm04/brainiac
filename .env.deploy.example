# Copy to .env.deploy and fill in. Never commit the filled file.

# ── Image version ───────────────────────────────────────────────────────
# The deploy stack PULLS prebuilt images from GHCR
# (ghcr.io/xkazm04/brainiac + …/brainiac-console), published by
# .github/workflows/release.yml on every `v*` tag. `latest` tracks the newest
# release; pin an exact tag (e.g. v0.3.0) for a reproducible host, then bump it
# deliberately. To build from source instead, layer docker-compose.build.yml —
# see docs/deploy/README.md.
BRAINIAC_IMAGE_TAG=latest

# Postgres (container-local; not exposed to the internet). Still give it a
# strong password — it is the credential the server uses over the Docker network.
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# ── LLM provider ────────────────────────────────────────────────────────
# BRAINIAC_PROVIDER selects the chat engine. Default `qwen` keeps the $0
# Alibaba recipe. Other values unlock the provider spectrum — set the matching
# key(s) below. Full matrix + per-stage routing: docs/deploy/providers.md.
#   qwen | openai | azure | openai-compat | anthropic | google | bedrock | vertex
BRAINIAC_PROVIDER=qwen
# Optional: pin the default model for the chosen provider (else its own default).
# BRAINIAC_MODEL=

# Qwen cloud — Model Studio, Singapore/international endpoint. The free
# quota (1M tokens per model, 90 days) covers a hackathon comfortably.
# Required only when BRAINIAC_PROVIDER=qwen (the default).
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# qwen-plus is the cost/quality sweet spot for extraction; qwen-max is better
# and also free-quota'd, qwen-flash is cheapest.
QWEN_MODEL=qwen-plus

# Other providers — uncomment the block for the one you selected above.
#   OpenAI (+ OpenAI-compatible via OPENAI_BASE_URL: Groq/Together/DeepSeek/…)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # e.g. https://api.groq.com/openai/v1
#   Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
#   Google Gemini
# GEMINI_API_KEY=...
# GOOGLE_MODEL=gemini-2.5-flash
#   Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
#   AWS Bedrock (Claude-on-Bedrock; SigV4)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
#   Google Vertex AI (service-account JSON inline, or a pre-minted token)
# GOOGLE_CLOUD_PROJECT=my-project
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_SA_JSON={"type":"service_account",...}   # or: VERTEX_ACCESS_TOKEN=ya29...

# Embeddings: `qwen` = DashScope text-embedding-v4 (1024-d). `openai` =
# text-embedding-3-small (needs OPENAI_API_KEY). `deterministic` needs no API at
# all but scores ~0.19 NDCG lower — see results/history/.
BRAINIAC_EMBEDDER=qwen

# Identity — BREAK-GLASS admin. This map is the bootstrap principal: the JSON
# KEY is the bearer secret, the value is the principal it acts as. Env-map
# entries carry EVERY scope and BYPASS the scope system entirely (auth.rs:
# scopes = None => allows() is always true). They are also un-revocable and
# un-audited. So treat this as break-glass only: use it once to mint scoped,
# revocable `brk_` keys (POST /v1/tokens — see docs/deploy/alibaba.md
# "Auth & the break-glass token"), then keep this secret offline.
#
# `scripts/first-boot.sh` does that hand-off for you once the stack is healthy:
# it mints the key, verifies it, rewrites BRAINIAC_API_TOKEN below, and restarts
# the console — without ever printing a secret. Its last instruction is to
# DELETE this line and keep the value in a password manager. Deleting it is
# safe: an absent map only logs a warning at boot, and `brk_` keys keep
# resolving from the api_tokens table. Restore it temporarily to mint or revoke.
#
# Generate a strong secret (do NOT prefix it with `brk_` — that prefix is
# reserved for minted keys) and generate the org/user UUIDs once, then keep both:
#   openssl rand -hex 32          # the bearer secret (the map key)
#   uuidgen                       # org id, then again for user id
#   BRAINIAC_TOKENS={"<secret>":{"org":"<uuid>","user":"<uuid>","teams":["<uuid>"]}}
#
# `teams` below is EMPTY, and a principal with no team cannot write memories:
# `POST /v1/memories` (and the MCP `memory_add` tool) refuse it with a 400 that
# explains why. That refusal is deliberate — a memory defaults to
# visibility='team' and takes its team from the writer's first team, so a
# teamless write would be stored with a NULL team and then be unreadable by
# everyone, including the writer (the `memories_read` RLS policy in
# migrations/0001_init.sql matches team-visible rows by `team_id IN (…)`).
# To write memories with this break-glass token, give its principal a team:
# put a real team uuid in `teams` AND add the user to that team in the
# `team_members` table — RLS reads the table, not the token. Reading, minting
# managed `brk_` keys, and every console operation work as-is without one.
BRAINIAC_TOKENS={"change-me-admin":{"org":"00000000-0000-0000-0000-000000000001","user":"00000000-0000-0000-0000-000000000002","teams":[]}}

# The token the console uses to reach the server (must exist in the map above,
# or be a managed `brk_` key minted later). For the FIRST boot set it to the
# break-glass secret above; then run `scripts/first-boot.sh`, which mints a
# scoped key, rewrites this line to the `brk_...` value and restarts the console
# so it runs on reduced, revocable authority instead of the break-glass token.
BRAINIAC_API_TOKEN=change-me-admin

# Console access gate. REQUIRED in production: the console reads and writes the
# live org knowledge base with the privileged token above, so without a passcode
# it refuses to serve anything but the public pitch ("/") and the fixture-org
# demo ("/demo"). Use a long random string — this is a shared secret for the
# deployment, not a per-user login.
#   openssl rand -base64 32
CONSOLE_PASSCODE=change-me-console

# REQUIRED (the deploy stack refuses to start without it). Keys the session
# cookie signature independently of the passcode. Without it,
# console/src/lib/auth.ts `signingKey()` silently falls back to keying on the
# PASSCODE itself — so anyone who guesses the passcode can forge a valid
# bx_console cookie offline and never meet /login's rate limiter. Rotating this
# value invalidates every outstanding session.
#   openssl rand -base64 32
CONSOLE_SESSION_SECRET=change-me-session-secret

# Public URL of the console (http://<public-ip> on the ECS recipe, or
# https://<your-domain> once BRAINIAC_DOMAIN below is set). Onboarding
# device-flow approval links are built from this; unset = localhost links.
BRAINIAC_CONSOLE_URL=http://change-me-public-ip

# ── TLS ─────────────────────────────────────────────────────────────────
# The stack ships a Caddy terminator (see deploy/Caddyfile). It is the only
# publicly bound service; the console listens on the Docker network only.
#
#   LEAVE UNSET  → Caddy serves plain HTTP on :80. Identical to the pre-Caddy
#                  behaviour and the only option for a bare-IP host, since no
#                  public CA issues certificates for an IP address.
#   SET a domain → Caddy obtains and renews a Let's Encrypt certificate
#                  automatically, serves HTTPS on 443, redirects 80 → 443.
#                  Nothing else to do: no certbot, no cron, no cert paths.
#
# Prerequisites for the domain mode: the A/AAAA record must ALREADY resolve to
# this host, and BOTH 80 and 443 must be open in the firewall / security group
# (ACME validates over port 80). Also set BRAINIAC_CONSOLE_URL to https://… so
# onboarding approval links match.
BRAINIAC_DOMAIN=
# Host-side port remap. Only useful when something else already owns 80/443 —
# e.g. a local rehearsal on a developer machine. Leave at the defaults on a
# real host, since ACME requires the standard ports.
# BRAINIAC_HTTP_PORT=80
# BRAINIAC_HTTPS_PORT=443

# ── Environment tag ─────────────────────────────────────────────────────
# "test" or "production" per host. One tag, three consumers:
#   1. Sentry:     gates whether it initializes at all (never when "local"),
#                  and tags every event.
#   2. LightTrack: stamped on every LLM-telemetry event as `environment`, so a
#                  developer's laptop can never be counted into this host's
#                  cost/quality rollup even if both point at one instance.
#   3. Log format: anything other than "local" ⇒ line-delimited JSON logs for
#                  host log aggregation (text locally).
BRAINIAC_ENV=production

# ── Sentry (error tracking) — TEST + PRODUCTION ─────────────────────────
# The Rust server initializes Sentry only when BRAINIAC_ENV != "local" AND
# SENTRY_DSN is set; leave unset to run without error tracking.
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Console (Next.js) — the SAME two vars above cover it; there is nothing extra
# to set. console/Dockerfile declares `ARG NEXT_PUBLIC_SENTRY_DSN` /
# `ARG NEXT_PUBLIC_BRAINIAC_ENV` before `npm run build`, and
# docker-compose.build.yml feeds them from SENTRY_DSN / BRAINIAC_ENV above.
#
# HEADS UP — console Sentry is BAKED IN AT BUILD TIME. Next.js substitutes
# `NEXT_PUBLIC_*` into the bundles when the image is built, so:
#   • Building from source (docker-compose.build.yml) ⇒ your DSN is compiled in.
#   • PULLING a released image ⇒ it carries whatever DSN the release workflow
#     built it with, and editing this file cannot change that. Self-hosters who
#     want console errors in their OWN Sentry project must build from source.
# The Rust server's SENTRY_DSN is unaffected either way — read at runtime, so a
# pulled image picks it up from this file directly.

# ── Plausible (product analytics) — CONSOLE, OPTIONAL ───────────────────
# The ONE behaviour-analytics tool: pageviews plus three funnel events
# (landing_view → signup_complete → activation), carrying no user, project or
# memory identifier. Cookieless — it sets no cookie and stores no per-visitor
# id, which is the whole reason console/app/privacy can state "the only cookie
# is the functional session cookie" and the site ships no consent banner.
#
# Unset ⇒ disabled entirely: no third-party script, no events, no errors.
#
# BAKED IN AT BUILD TIME, exactly like the console's Sentry DSN above. Setting
# it in this file on a host running a PULLED image does nothing — the value has
# to be present during `next build`, which means console/Dockerfile must declare
# `ARG NEXT_PUBLIC_PLAUSIBLE_DOMAIN` and the compose build file must feed it.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=brainiac.example.com
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ── LightTrack (LLM-call telemetry) — TEST + PRODUCTION ─────────────────
# One fire-and-forget event per LLM completion (provider, model, tokens,
# latency, status) plus the BRAINIAC_ENV tag above as `environment`. Every
# failure is swallowed on a background thread — telemetry can never slow or
# break the server, and a wrong/unreachable URL degrades to silence.
#
# Blank or unset LIGHTTRACK_URL ⇒ disabled entirely (no-op). Fill in your own
# instance URL to turn it on; because events carry `environment`, test and
# production can share one instance and be told apart by that field.
LIGHTTRACK_URL=
# Optional bearer token; when set the server derives the project from the key.
# Keep the real value out of git — fill it in .env.deploy only.
LIGHTTRACK_KEY=
# Optional project id (used with a dev-mode/admin key).
LIGHTTRACK_PROJECT=brainiac

RUST_LOG=info
