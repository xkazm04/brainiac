# Copy to .env.deploy and fill in. Never commit the filled file.

# Postgres (container-local; not exposed to the internet). Still give it a
# strong password — it is the credential the server uses over the Docker network.
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Qwen cloud — Model Studio, Singapore/international endpoint. The free
# quota (1M tokens per model, 90 days) covers a hackathon comfortably.
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# qwen-plus is the cost/quality sweet spot for extraction; qwen-max is better
# and also free-quota'd, qwen-flash is cheapest.
QWEN_MODEL=qwen-plus
# Embeddings: `qwen` = DashScope text-embedding-v4 (1024-d). `deterministic`
# needs no API at all but scores ~0.19 NDCG lower — see results/history/.
BRAINIAC_EMBEDDER=qwen

# Identity — BREAK-GLASS admin. This map is the bootstrap principal: the JSON
# KEY is the bearer secret, the value is the principal it acts as. Env-map
# entries carry EVERY scope and BYPASS the scope system entirely (auth.rs:
# scopes = None => allows() is always true). They are also un-revocable and
# un-audited. So treat this as break-glass only: use it once to mint scoped,
# revocable `brk_` keys (POST /v1/tokens — see docs/deploy/alibaba.md
# "Auth & the break-glass token"), then keep this secret offline.
#
# Generate a strong secret (do NOT prefix it with `brk_` — that prefix is
# reserved for minted keys) and generate the org/user UUIDs once, then keep both:
#   openssl rand -hex 32          # the bearer secret (the map key)
#   uuidgen                       # org id, then again for user id
#   BRAINIAC_TOKENS={"<secret>":{"org":"<uuid>","user":"<uuid>","teams":["<uuid>"]}}
BRAINIAC_TOKENS={"change-me-admin":{"org":"00000000-0000-0000-0000-000000000001","user":"00000000-0000-0000-0000-000000000002","teams":[]}}

# The token the console uses to reach the server (must exist in the map above,
# or be a managed `brk_` key minted later). For the FIRST boot set it to the
# break-glass secret above; once you have minted a scoped key, change this to
# that `brk_...` value and `docker compose ... up -d console` so the console
# runs on reduced, revocable authority instead of the break-glass token.
BRAINIAC_API_TOKEN=change-me-admin

# Console access gate. REQUIRED in production: the console reads and writes the
# live org knowledge base with the privileged token above, so without a passcode
# it refuses to serve anything but the public pitch ("/") and the fixture-org
# demo ("/demo"). Use a long random string — this is a shared secret for the
# deployment, not a per-user login.
#   openssl rand -base64 32
CONSOLE_PASSCODE=change-me-console

# Recommended in production: keys the session cookie signature independently of
# the passcode, so a guessed passcode can't be turned straight into a valid
# cookie (bypassing the login rate limiter).
#   openssl rand -base64 32
CONSOLE_SESSION_SECRET=change-me-session-secret

# Public URL of the console (http://<public-ip> on the ECS recipe). Onboarding
# device-flow approval links are built from this; unset = localhost links.
BRAINIAC_CONSOLE_URL=http://change-me-public-ip

# ── Environment tag (Sentry) ────────────────────────────────────────────
# "test" or "production" per host. Stamped on every Sentry event and gates
# whether Sentry initializes at all (never runs when this is "local").
BRAINIAC_ENV=production

# ── Sentry (error tracking) — TEST + PRODUCTION ─────────────────────────
# The Rust server initializes Sentry only when BRAINIAC_ENV != "local" AND
# SENTRY_DSN is set; leave unset to run without error tracking.
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Console (Next.js) — browser-visible public DSN + env tag.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
NEXT_PUBLIC_BRAINIAC_ENV=production

# ── LightTrack (LLM-call telemetry) — TEST ONLY; PRODUCTION SKIPPED ─────
# UNSET ⇒ disabled (no-op). Point a test host at your test LightTrack instance.
# Production is deliberately skipped for now — leave all three unset there.
#   test       → LIGHTTRACK_URL=https://<your-test-lighttrack-instance>
#   production → SKIPPED — leave unset
# LIGHTTRACK_URL=https://<your-test-lighttrack-instance>
# LIGHTTRACK_KEY=
# LIGHTTRACK_PROJECT=brainiac

RUST_LOG=info
