{
  "name": "brainiac-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "cross-env NEXT_DIST_DIR=.next-build next build",
    "start": "cross-env NEXT_DIST_DIR=.next-build next start -p 3100",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:fresh": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\" && next dev -p 3100",
    "gen:api": "openapi-typescript ../openapi.json -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "next": "^15.5.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.0"
  }
}
