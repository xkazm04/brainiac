# Copy to .env for local development. Never commit the filled file.
#
# This documents the LOCAL-dev posture. For a deployed (test/production) host
# see .env.deploy.example, which carries the same keys with deploy values.

# ── Core ────────────────────────────────────────────────────────────────
# Postgres (docker-compose maps 5433 → the container's 5432).
DATABASE_URL=postgres://brainiac:brainiac@127.0.0.1:5433/brainiac

# Qwen (DashScope, OpenAI-compatible). Needed for the real pipeline; the
# deterministic embedder + --mock provider run without it.
QWEN_API_KEY=sk-...
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Environment tag ─────────────────────────────────────────────────────
# Stamped on Sentry events and gates whether Sentry runs at all. Unset ⇒
# "local". Keep it "local" in dev so nothing phones home.
#   local      → Sentry OFF (default)
#   test       → Sentry ON if SENTRY_DSN set
#   production → Sentry ON if SENTRY_DSN set
BRAINIAC_ENV=local

# ── Sentry (error tracking) — TEST + PRODUCTION ONLY ────────────────────
# Deliberately OFF in local dev: the Rust server never initializes Sentry when
# BRAINIAC_ENV=local or SENTRY_DSN is unset, so these stay commented here.
#   local      → leave unset (OFF)
#   test       → set SENTRY_DSN + BRAINIAC_ENV=test
#   production → set SENTRY_DSN + BRAINIAC_ENV=production
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# Console (Next.js) uses its own public DSN + env tag (browser-visible):
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_BRAINIAC_ENV=local

# ── LightTrack (LLM-call telemetry) — LOCAL + TEST ONLY ─────────────────
# The gateway emits one fire-and-forget event per LLM completion (provider,
# model, tokens, latency) when LIGHTTRACK_URL is set. UNSET ⇒ disabled (no-op).
# Production is deliberately SKIPPED for now (leave all three unset there).
#   local      → LIGHTTRACK_URL=http://127.0.0.1:8787  (docker compose up -d lighttrack)
#   test       → LIGHTTRACK_URL=https://<your-test-lighttrack-instance>
#   production → SKIPPED — leave unset
LIGHTTRACK_URL=http://127.0.0.1:8787
# Optional bearer token; when set the server derives the project from the key.
# LIGHTTRACK_KEY=
# Optional project id (dev mode / admin key).
LIGHTTRACK_PROJECT=brainiac

RUST_LOG=info
